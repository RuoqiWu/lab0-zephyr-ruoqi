mainmenu "Sum Application Configuration"

choice SUM_IMPLEMENTATION
	prompt "Select the sum output implementation"
	default SUM_PRINT

config SUM_PRINT
	bool "Use printk implementation"
	select PRINTK

config SUM_LOG
	bool "Use Logger implementation"
	select LOG

endchoice

config LAB_BME280
	bool "Part 8 BME280 register temperature reader"
	depends on I2C

source "Kconfig.zephyr"
